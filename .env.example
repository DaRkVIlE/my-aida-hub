# AIDA Hub — Configuração de Ambiente
# Copie para .env e preencha com seus valores.

# URL do AIDA Chat (LibreChat) — usado para redirect de login e links das personas
VITE_AIDA_CHAT_URL=https://aida.experiasolutions.com.br

# URL da API do AIDA Chat — mesmo host em produção, proxy em dev local
# Em produção: deixar vazio (usa VITE_AIDA_CHAT_URL como base)
# Em desenvolvimento local: http://localhost:3080
VITE_AIDA_API_URL=https://aida.experiasolutions.com.br

# Porta local do Hub (usado pelo Vite dev server)
# PORT=5173
